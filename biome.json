{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!apps/desktop/build",
      "!site",
      "!prototype/mobile/ios",
      "!prototype/mobile/android",
      "!prototype/mobile/.expo",
      "!prototype/mobile/uniwind-types.d.ts",
      "!apps/mobile/ios",
      "!apps/mobile/android",
      "!apps/mobile/.expo",
      "!apps/mobile/uniwind-types.d.ts",
      "!**/test-results",
      "!**/playwright-report",
      "!**/bun.lock",
      "!packages/contracts/generated",
      "!packages/engine-hermes/plugin/lilos/catalog.json",
      "!**/*.svg",
      "!**/*.png",
      "!**/*.ico",
      "!**/*.icns"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "overrides": [
    {
      "includes": ["prototype/web/src/**", "prototype/web/vite.config.ts"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false },
      "assist": { "actions": { "source": { "organizeImports": "off" } } }
    },
    {
      "includes": ["packages/ui/src/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useButtonType": "off",
            "useKeyWithClickEvents": "off",
            "noStaticElementInteractions": "off",
            "useSemanticElements": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noControlCharactersInRegex": "off"
          },
          "style": { "noNonNullAssertion": "off" },
          "correctness": { "useExhaustiveDependencies": "off" }
        }
      }
    },
    {
      "includes": [
        "packages/ui/src/components/ui/**",
        "packages/ui/src/components/ai-elements/**"
      ],
      "linter": { "enabled": false },
      "formatter": { "enabled": false },
      "assist": { "actions": { "source": { "organizeImports": "off" } } }
    }
  ]
}
