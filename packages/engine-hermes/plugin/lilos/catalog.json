          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "topic",
          "title",
          "body"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      },
      "_meta": {
        "lilos/area": "root",
        "lilos/access": "read"
      }
    },
