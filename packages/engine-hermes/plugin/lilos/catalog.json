        "lilos/access": "read"
      }
    },
    {
      "name": "workbench_previews",
      "description": "List dev-server preview URLs the user's Workbench shows for this session (URL scan + PREVIEW: markers).",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "previews": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "via": {
                  "type": "string",
                  "enum": [
                    "scan",
                    "marker"
                  ]
                }
              },
              "required": [
                "url",
                "via"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "previews"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      },
      "_meta": {
        "lilos/area": "workbench",
        "lilos/access": "read"
      }
    },
    {
      "name": "workbench_open",
      "description": "Show the user something in this session's Workbench: `{file, line?}`, `{diff, path?}`, `{pr}`, `{url}` or `{tab:'subagents'|'background'|'plan'}` — the panel opens on that tab. A session with no folder accepts `tab` targets only (the rest error). It never opens an editor on the Mac.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "file": {
            "description": "Session-folder file to show",
            "type": "string",
            "minLength": 1
          },
          "line": {
            "description": "1-based line inside `file` to highlight",
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "diff": {
            "description": "Open the Changes tab — the session's live git diff",
            "type": "boolean",
            "const": true
          },
          "path": {
            "description": "Filter Changes to one file (with `diff`)",
            "type": "string",
            "minLength": 1
          },
          "pr": {
            "description": "Open the PR tab for the thread's pull requests",
            "type": "boolean",
            "const": true
          },
          "url": {
            "description": "Preview URL to open on the Preview tab",
            "type": "string",
            "minLength": 1
          },
          "tab": {
            "description": "Engine tab to open (the only kind a folderless session accepts)",
            "type": "string",
            "enum": [
              "subagents",
              "background",
              "plan"
            ]
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "opened": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "opened"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false
      },
      "_meta": {
        "lilos/area": "workbench",
        "lilos/access": "write"
      }
    },
    {
      "name": "context",
      "description": "Who and where this session is: the employee record, DM, thread, folder, context usage { used, window }, the user's name, Mac status and attached tool areas.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "employee": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string"
              },
              "profile": {
                "type": "string"
              },
              "model": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "role",
              "profile",
              "model"
            ],
            "additionalProperties": false
          },
          "channel": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind"
            ],
            "additionalProperties": false
          },
          "thread": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": [
                  "idle",
                  "active",
                  "closed"
                ]
              },
              "model": {
                "type": "string"
              },
              "access": {
                "type": "string",
                "enum": [
                  "ask",
                  "full"
                ]
              }
            },
            "required": [
              "id",
              "title",
              "state",
              "access"
            ],
            "additionalProperties": false
          },
          "folder": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              },
              "repoPath": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          "user": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "mac": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "ok",
                  "degraded",
                  "down"
                ]
              },
              "components": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "enum": [
                        "relay",
                        "harness",
                        "engine",
                        "model"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "connecting",
                        "degraded",
                        "blocked",
                        "down"
                      ]
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "state",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "state",
              "components"
            ],
            "additionalProperties": false
          },
          "usage": {
            "type": "object",
            "properties": {
              "used": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "window": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "used"
            ],
            "additionalProperties": false
          },
          "areas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hostPolicyVersion": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "employee",
          "channel",
          "thread",
          "user",
          "mac",
          "areas",
          "hostPolicyVersion"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      },
      "_meta": {
        "lilos/area": "root",
        "lilos/access": "read"
      }
    },
    {
      "name": "guide",
