    {
      "name": "thread_read",
      "description": "Read the visible messages of a thread in this DM — the session's own unless `thread` names another by id or title; `before`/`afterSeq` window it.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "thread": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "before": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "afterSeq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "thread": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string"
              },
              "access": {
                "type": "string",
                "enum": [
                  "ask",
                  "full"
                ]
              }
            },
            "required": [
              "id",
              "title",
              "access"
            ],
            "additionalProperties": false
          },
          "messages": {
            "type": "array",
            "items": {
