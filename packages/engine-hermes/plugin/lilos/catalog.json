        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false
      },
      "_meta": {
        "lilos/area": "terminal",
        "lilos/access": "write"
      }
    },
    {
      "name": "terminal_read",
      "description": "Read the terminal's recent output (scrollback tail).",
