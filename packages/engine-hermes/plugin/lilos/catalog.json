              "channelId",
              "authorId",
              "text",
              "seq",
              "createdAt",
              "conversationId",
              "authorKind",
              "rewound",
              "dropped",
              "removed",
              "claimed"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false
