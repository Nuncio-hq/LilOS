            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false
      },
      "_meta": {
        "lilos/area": "browser",
        "lilos/access": "write"
      }
    },
    {
      "name": "browser_read",
