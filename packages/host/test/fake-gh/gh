#!/usr/bin/env bun
/**
 * Deterministic fake `gh` for tests/CI (issue #37). State lives in $GH_FAKE_DIR
 * (default: `<this dir>/.gh-fake`): `view.json` is the PR that `gh pr view`
 * answers; `pr comment` appends to its comments and `pr merge` flips it to
 * MERGED — so the harness's re-read sees the post-action truth, like real gh.
 * Missing `view.json` = the branch has no PR (exit 1, like real gh).
 * Every invocation is appended to $GH_FAKE_LOG when that env var is set.
 */
import { execFileSync } from "node:child_process";
import {
  appendFileSync,
  existsSync,
  readFileSync,
  writeFileSync,
} from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const dir =
  process.env.GH_FAKE_DIR ??
  join(dirname(fileURLToPath(import.meta.url)), ".gh-fake");
const logFile = process.env.GH_FAKE_LOG;
const args = process.argv.slice(2);
if (logFile) appendFileSync(logFile, `${args.join(" ")}\n`);

const fail = (msg: string): never => {
  console.error(msg);
  process.exit(1);
};

/* Forced failure (issue #114 AC-5): a file `fail` in $GH_FAKE_DIR makes every
   call fail before doing anything. Content "auth" = real gh's signed-out
   answer (its "gh auth login" stderr and exit 4); any other text = a generic
   failure carrying that text. Absent = normal fixture behaviour. */
const forcedFail = existsSync(join(dir, "fail"))
  ? readFileSync(join(dir, "fail"), "utf8").trim()
  : null;
if (forcedFail !== null) {
  if (forcedFail === "auth") {
    console.error(
      "To get started with GitHub CLI, please run: gh auth login\n" +
        "Alternatively, populate the GH_TOKEN environment variable with a " +
        "personal access token.",
    );
    process.exit(4);
  }
  fail(`fake gh: ${forcedFail || "forced failure"}`);
}

const viewPath = join(dir, "view.json");
const readView = (): Record<string, any> =>
  JSON.parse(readFileSync(viewPath, "utf8"));
const writeView = (v: Record<string, any>) =>
  writeFileSync(viewPath, `${JSON.stringify(v, null, 2)}\n`);
const flag = (name: string) => args[args.indexOf(name) + 1];

// Matches real gh's message for "the current branch has no PR" — the host maps
// it to `pr: null` / PR_NOT_FOUND rather than a generic failure.
const noPr = () => fail('no pull requests found for branch "main"');

switch (`${args[0]} ${args[1]}`) {
  case "auth status": {
    console.log("github.com\n  ✓ Logged in to github.com as fake-gh");
    break;
  }
  case "pr view": {
    if (!existsSync(viewPath)) noPr();
    const raw = readFileSync(viewPath, "utf8");
    try {
      JSON.parse(raw);
    } catch (e) {
      fail(`fake gh: invalid view.json: ${(e as Error).message}`);
    }
    process.stdout.write(raw);
    break;
  }
  case "pr list": {
    /* `gh pr list --head <branch>` (#159): serves `list-<branch>.json`
       (`/` sanitized to `__`); a missing fixture = no PRs for that head —
       real gh prints `[]` for that, never an error. */
    const head = flag("--head");
    if (!head) fail("pr list needs --head");
    const listPath = join(dir, `list-${head.replaceAll("/", "__")}.json`);
    if (!existsSync(listPath)) {
      process.stdout.write("[]\n");
      break;
    }
    process.stdout.write(readFileSync(listPath, "utf8"));
    break;
  }
  case "pr create": {
    /* `gh pr create --title --body [--base]` (issue #107): writes view.json
       — the host's `forge.pr` re-read then sees the PR it just made, like
       real gh. The head is the checkout's current branch; a `head` override
       rides in $GH_FAKE_HEAD when a test can't move the checkout. */
    const title = flag("--title") ?? fail("pr create needs --title");
    const body = flag("--body") ?? fail("pr create needs --body");
    const base = flag("--base") ?? "main";
    const head =
      process.env.GH_FAKE_HEAD ??
      (() => {
        try {
          return execFileSync("git", ["symbolic-ref", "--short", "HEAD"], {
            encoding: "utf8",
          }).trim();
        } catch {
          return "feat/forge";
        }
      })();
    const number = 8;
    const url = `https://github.com/acme/widgets/pull/${number}`;
    writeView({
      number,
      title,
      body,
      url,
      state: "OPEN",
      author: { login: "oscar" },
      baseRefName: base,
      headRefName: head,
      createdAt: new Date().toISOString(),
      mergedAt: null,
      mergedBy: null,
      mergeCommit: null,
      mergeable: "MERGEABLE",
      statusCheckRollup: [],
      comments: [],
    });
    console.log(url);
    break;
  }
  case "pr comment": {
    if (!existsSync(viewPath)) noPr();
    const body = flag("--body") ?? fail("comment needs --body");
    const v = readView();
    const comments = (v.comments ?? []) as unknown[];
    comments.push({
      author: { login: "oscar" },
      body,
      createdAt: new Date().toISOString(),
    });
    writeView({ ...v, comments });
    console.log(`${v.url}#issuecomment-9001`);
    break;
  }
  case "pr merge": {
    if (!existsSync(viewPath)) noPr();
    const method = ["--squash", "--merge", "--rebase"].find((f) =>
      args.includes(f),
    );
    if (!method) fail("merge needs a method flag");
    const v = readView();
    if (v.state !== "OPEN")
      fail(`pull request #${v.number} is not mergeable (state ${v.state})`);
    // Real `gh pr merge` refuses a conflicting PR the same way.
    if (v.mergeable === "CONFLICTING")
      fail(`pull request #${v.number} is not mergeable: conflicts with base`);
    writeView({
      ...v,
      state: "MERGED",
      mergedAt: new Date().toISOString(),
      mergedBy: { login: "oscar" },
      mergeCommit: { oid: "f".repeat(40) },
    });
    console.log(`${method.slice(2)} merged pull request #${v.number}`);
    break;
  }
  default:
    fail(`fake gh: unhandled command: ${args.join(" ")}`);
}
