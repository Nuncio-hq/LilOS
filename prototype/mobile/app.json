{
  "expo": {
    "name": "LilOS",
    "slug": "lilos",
    "scheme": "lilos",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nuncio.lilos.mobile"
    },
    "experiments": {
      "autolinkingModuleResolution": true
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "LilOS uses the camera to scan the pairing code shown on your Mac."
        }
      ]
    ]
  }
}
